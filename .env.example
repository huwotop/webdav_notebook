# ============================================================
# Cloudflare Pages 部署说明
# ============================================================
# 本项目已适配 Cloudflare Pages 部署。
# 请勿使用 .env 文件！所有变量请在 Cloudflare Pages 控制台设置：
#   项目 -> Settings -> Environment variables
#
# 部署步骤：
#   1. 运行 npm install
#   2. 运行 npm run build 生成 dist/ 目录
#   3. 在 Cloudflare Pages 控制台创建项目，或运行 npm run deploy
#   4. 在 Pages 设置中配置以下环境变量（无需加前缀）
#
# ============================================================
# Cloudflare KV 缓存配置（可选，但强烈推荐）
# ============================================================
# Cloudflare KV 可用作 WebDAV 回源前的缓存层，显著降低响应延迟，
# 同时节省 WebDAV 服务器的带宽。免费额度非常充足：
#   100,000 次读取 / 天，1,000 次写入 / 天，1 GB 存储。
#
# 启用步骤（仅一次）：
#   1) 控制台 -> Workers & Pages -> KV -> Create a namespace
#      Name 填: webdav-notepad-cache  (任意名字)
#      创建后复制 Namespace ID
#
#   2) 回到 Pages 项目 -> Settings -> Functions -> KV namespace bindings -> Add binding
#      Variable name:  NOTE_CACHE    （必须完全一致，代码里用这个名字读取）
#      KV namespace:  选择上面创建的那个
#
#   3) （可选）在 Environment variables 中添加：
#      KV_CACHE_TTL = 3600    缓存存活秒数，默认 3600 = 1 小时
#
# 如果未做上述绑定，代码会自动跳过 KV 缓存，直接访问 WebDAV，不报错。
# ============================================================

# WebDAV Configuration
WEBDAV_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
WEBDAV_PATH=/WebDAV-Notes

# App Customization
SITE_NAME=云端网络记事本
AUTH_PASSWORD=
LOCK_PASSWORD=

# Gemini API Key (Server-side Functions)
# （已移除，如需 AI 相关能力请自行二次开发接入）

# KV Cache TTL in seconds (optional, default 3600 = 1 hour)
KV_CACHE_TTL=3600
